{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "Injection Options",
  "description": "Options JSON file for JavaScript Injector",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [ "meta" ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" }
  },
  "patternProperties": {
    "^https://": { "$ref": "#/$defs/origin" }
  },
  "$defs": {
    "meta": {
      "description": "File metadata containing settings version",
      "type": "object",
      "unevaluatedProperties": false,
      "required": [ "version" ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{10}$"
        }
      }
    },
    "origin": {
      "description": "Contains actions for a specific origin",
      "type": "object",
      "unevaluatedProperties": false,
      "patternProperties": {
        "": {
          "description": "List of scripts to run on a specific action",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/scripts/.*\\.js$"
          }
        }
      }
    }
  }
}